<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Version>0.1.0-preview.3</Version>
    <AssemblyName>PadToMIDI</AssemblyName>
    <RootNamespace>PadToMIDI.App</RootNamespace>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.2</FileVersion>
    <Product>PadToMIDI</Product>
    <Description>Expressive gamepad MIDI instrument for Windows</Description>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/app.ico" />
    <ProjectReference Include="../PadToMIDI.Core/PadToMIDI.Core.csproj" />
    <ProjectReference Include="../PadToMIDI.Input.Sdl/PadToMIDI.Input.Sdl.csproj" />
    <ProjectReference Include="../PadToMIDI.Midi.Windows/PadToMIDI.Midi.Windows.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Profiles/default-c-major.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
